<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RoR2LatencyMod</AssemblyName>
    <RootNamespace>RoR2LatencyMod</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Local install paths; assemblies are referenced from disk and never copied into the repo. -->
  <PropertyGroup>
    <BepInExCore>$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles\Default\BepInEx\core</BepInExCore>
    <MMHookDir>$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles\Default\BepInEx\plugins\MMHOOK</MMHookDir>
    <R2ApiCoreDir>$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles\Default\BepInEx\plugins\RiskofThunder-R2API_Core\R2API.Core</R2ApiCoreDir>
    <RiskOfOptionsDir>$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles\Default\BepInEx\plugins\Rune580-Risk_Of_Options\RiskOfOptions</RiskOfOptionsDir>
    <GameManaged>N:\steam\steamapps\common\Risk of Rain 2\Risk of Rain 2_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MMHOOK_RoR2">
      <HintPath>$(MMHookDir)\MMHOOK_RoR2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="R2API.Core">
      <HintPath>$(R2ApiCoreDir)\R2API.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 只做编译期 API 校验，不复制、不打进发布物；运行期靠 PluginInfos 检查守门。 -->
    <Reference Include="RiskOfOptions">
      <HintPath>$(RiskOfOptionsDir)\RiskOfOptions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RoR2">
      <HintPath>$(GameManaged)\RoR2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Animator.PlayInFixedTime for the local ShieldTackleExit reset; ships with the game. -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SphereCollider radius of the hook projectile (crosshair reach); ships with the game. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Image/HGTextMeshProUGUI HUD elements; both ship with the game. -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- RectTransform/Canvas types used by the HUD host; ships with the game. -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.unity.multiplayer-hlapi.Runtime">
      <HintPath>$(GameManaged)\com.unity.multiplayer-hlapi.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
